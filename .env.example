# 
# English Buddy Telegram Bot - Environment Configuration Template
#
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit the actual '.env' file to Git!

# Required: Telegram Bot Token obtained from @BotFather on Telegram
# Format: <10-digit-id>:<35-char-token-hash>
TELEGRAM_BOT_TOKEN=

# Required for Webhook Production: Custom secret token to validate incoming requests
# Must match the 'secret_token' parameter used when calling setWebhook
# Recommended: generate using `python -c "import secrets; print(secrets.token_urlsafe(32))"`
WEBHOOK_SECRET=

# Optional: In-Memory Sliding Window Rate Limiting Configuration
# Maximum requests per window before dropping / warning the user
RATE_LIMIT_MAX_REQUESTS=5
# Window duration in seconds
RATE_LIMIT_WINDOW_SECONDS=10.0
# Maximum unique users to track in memory (LRU eviction protects against DoS)
RATE_LIMIT_MAX_TRACKED_USERS=10000

# Optional: Input Guardrail Configuration
# Maximum allowed character length for incoming user messages
MAX_MESSAGE_LENGTH=300

# Optional: Google Gemini Flash AI Integration (Hybrid Mode)
# If provided, the bot uses Gemini Flash for infinite dynamic exercises and smart grading.
# If omitted, the bot seamlessly falls back to the rich offline random generator!
GEMINI_API_KEY=
GEMINI_MODEL=

